{
  "name": "coachos",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "npm run dev -w @coachos/web",
    "build": "npm run build -w @coachos/web",
    "start": "npm run start -w @coachos/web",
    "typecheck": "npm run typecheck -w @coachos/domain && npm run typecheck -w @coachos/web",
    "lint": "npm run lint -w @coachos/web",
    "test": "vitest run",
    "db:reset": "npm run db:reset -w @coachos/web",
    "supabase:start": "PATH=\"$PATH:$HOME/.docker/bin\" supabase start -x studio,imgproxy,vector,logflare,edge-runtime,realtime,postgres-meta,supavisor",
    "supabase:stop": "PATH=\"$PATH:$HOME/.docker/bin\" supabase stop",
    "supabase:status": "PATH=\"$PATH:$HOME/.docker/bin\" supabase status",
    "supabase:env": "npm run supabase:env -w @coachos/web",
    "supabase:seed": "npm run supabase:seed -w @coachos/web",
    "test:pg": "COACHOS_TEST_PG=1 vitest run --no-file-parallelism apps/web/server/loop.test.ts apps/web/server/concurrency.test.ts",
    "supabase:migrate": "PATH=\"$PATH:$HOME/.docker/bin\" supabase migration up",
    "db:backup": "node scripts/db-backup.mjs",
    "db:restore": "node scripts/db-restore.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "supabase": "^3.2.0",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
